{
  "name": "@pawquest/web-demo",
  "version": "0.0.0",
  "private": true,
  "description": "Public web demo: the real app screens in a browser over an in-memory SQLite (sql.js) with demo data.",
  "main": "index.ts",
  "scripts": {
    "prepare:wasm": "node scripts/copy-wasm.mjs",
    "web": "node scripts/copy-wasm.mjs && expo start --web --port 8091",
    "export": "node scripts/copy-wasm.mjs && expo export --platform web",
    "typecheck": "tsc -p tsconfig.json",
    "test": "echo \"no web-demo tests\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@pawquest/data": "workspace:*",
    "@pawquest/i18n": "workspace:*",
    "@pawquest/rn-ui": "workspace:*",
    "@pawquest/screens": "workspace:*",
    "expo": "~57.0.29",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.4",
    "sql.js": "^1.15.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "@types/sql.js": "^1.4.11"
  }
}
