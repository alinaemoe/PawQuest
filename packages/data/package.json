{
  "name": "@pawquest/data",
  "version": "0.0.0",
  "private": true,
  "description": "PawQuest data layer: SQLite migrations, Drizzle schema, connection setup. No UI, no business logic.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./expo": "./src/adapters/expo.ts"
  },
  "scripts": {
    "gen": "node scripts/gen-migrations.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "@pawquest/core": "workspace:*",
    "@pawquest/weather": "workspace:*"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.4",
    "expo-sqlite": "~57.0.4",
    "vitest": "5.0.4"
  },
  "peerDependencies": {
    "expo-sqlite": "*"
  },
  "peerDependenciesMeta": {
    "expo-sqlite": {
      "optional": true
    }
  }
}
